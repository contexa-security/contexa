<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{ISO8601} %-5level %logger{60} - %replace(%msg){'sk-[A-Za-z0-9_-]{20,}', '[REDACTED]'}%n%nopex</pattern></encoder>
    </appender>
    <logger name="org.springframework.boot" level="INFO"/>
    <logger name="io.contexa.demo" level="INFO"/>
    <root level="ERROR"><appender-ref ref="CONSOLE"/></root>
</configuration>
