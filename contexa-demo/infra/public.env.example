# Copy outside version control. This file contains paths and non-secret settings only.
COMPOSE_PROJECT_NAME=contexa-runtime-lab-public
LAB_SECRET_DIRECTORY=/absolute/private/secrets
LAB_TLS_DIRECTORY=/absolute/private/tls
# Generate a UUID once per generation; the hex must be that UUID without hyphens.
LAB_WORKSPACE_GENERATION=REPLACE_WITH_UUID
LAB_GENERATION_HEX=REPLACE_WITH_UUID_WITHOUT_HYPHENS
LAB_RP_ID=lab.example.com
LAB_PORTAL_URL=https://lab.example.com:19080
LAB_BASELINE_URL=https://lab.example.com:19081
LAB_CONTEXA_URL=https://lab.example.com:19082
LAB_PORTAL_PORT=19080
LAB_BASELINE_PORT=19081
LAB_CONTEXA_PORT=19082
LAB_WORKSPACE_LIFETIME=30m
LAB_CHAT_PROVIDER=openai
LAB_CHAT_MODEL=gpt-5-nano
LAB_OLLAMA_URL=http://host.docker.internal:11434
SPRING_MAIL_HOST=REPLACE_WITH_SMTP_HOST
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
LAB_EMAIL_FROM=REPLACE_WITH_SENDER
LAB_MAIL_STARTTLS=true
