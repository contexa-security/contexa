# Variables of the production stack (compose.stack.yml + compose.production.yml). Copy to the server as
# /opt/contexa/showcase.env, fill in the values there and never commit the filled file.

# Database password of all applications: 12 characters or more, not a known default.
SHOWCASE_DB_PASSWORD=
# HMAC key of the signed internal context, base64 of 32 random bytes or more (openssl rand -base64 48).
SHOWCASE_INTERNAL_SIGNING_KEY=
# Model provider key of control D.
OPENAI_API_KEY=

# Public https address of the portal; share links and their cards use it.
SHOWCASE_PUBLIC_URL=https://demo.ctxa.ai
# Address the portal publishes on the host, behind the reverse proxy.
SHOWCASE_PORTAL_PUBLISH=127.0.0.1:19180
# Tomcat internal-proxies pattern of the reverse proxy address as the portal container sees it (a Java regex),
# for example the Docker bridge gateway: 172\.(1[6-9]|2[0-9]|3[0-1])\.\d{1,3}\.\d{1,3}
SHOWCASE_TRUSTED_PROXIES=

# Cloudflare Turnstile of the public host.
SHOWCASE_TURNSTILE_SITE_KEY=
SHOWCASE_TURNSTILE_SECRET_KEY=
SHOWCASE_TURNSTILE_HOSTNAMES=demo.ctxa.ai

# Optional; the defaults are shown.
# SHOWCASE_LIVE_ENABLED=true
# SHOWCASE_LIVE_SCENARIOS=K2
# Starts per minute that fit the provider's tokens-per-minute limit: about limit / 16,000 (12 for 200,000).
# SHOWCASE_LIVE_STARTS_PER_MINUTE=12
# SHOWCASE_LIVE_MONTHLY_BUDGET_USD=30
